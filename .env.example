# Copy this file to `.env` on the VPS (next to docker-compose.prod.yml) and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# NOTE: These variables configure the RUNNING STACK on the VPS.
# They are NOT GitHub Actions secrets. The pipeline only needs the VPS_* SSH
# secrets (see DEPLOYMENT.md) — GHCR push uses the built-in GITHUB_TOKEN.
# Images are pulled from ghcr.io/geist-app/geist-backend and geist-frontend.

# --- PostgreSQL ---
POSTGRES_USER=geist
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=geist

# --- Backend ---
# Must match the Postgres credentials above; host is the compose service name `postgres`.
DATABASE_URL=postgresql://geist:change-me-strong-random@postgres:5432/geist
JWT_SECRET=change-me-strong-random

# Image tag to run. Left as `latest` for manual `up`; the CI deploy step overrides
# this with the short commit SHA for immutable, rollback-able deploys.
IMAGE_TAG=latest
